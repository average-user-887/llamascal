From d9efbb62677a2b23a33ae4d507e668d751944225 Mon Sep 17 00:00:00 2001
From: p104-k1-builder <k1@z4-p104.local>
Date: Mon, 23 Nov 2026 02:55:28 +0100
Subject: [PATCH 06/20] p104 k1 v7: use the wide Q4_K/Q5_K vec_dot only for
 ncols_dst == 1 (n = 2..8 regressed up to -28% with it)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq.cu | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 93d972a..cf279a7 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -623,12 +623,13 @@ static constexpr __device__ int get_mmvq_mmid_max_batch_for_device() {
 #endif
 }
 
-static constexpr __host__ __device__ int get_vdr_mmvq_tbl(ggml_type type, mmvq_parameter_table_id table_id) {
-    return table_id == MMVQ_PARAMETERS_PASCAL && mmvq_pascal_wide(type) ? 8 : get_vdr_mmvq(type);
+// The wide vec_dot is only used for one column, the multi-column launch shapes are tuned for vdr 2.
+static constexpr __host__ __device__ int get_vdr_mmvq_tbl(ggml_type type, mmvq_parameter_table_id table_id, int ncols_dst) {
+    return table_id == MMVQ_PARAMETERS_PASCAL && ncols_dst == 1 && mmvq_pascal_wide(type) ? 8 : get_vdr_mmvq(type);
 }
 
-static constexpr __device__ vec_dot_q_cuda_t get_vec_dot_q_cuda_tbl(ggml_type type, mmvq_parameter_table_id table_id) {
-    if (table_id == MMVQ_PARAMETERS_PASCAL) {
+static constexpr __device__ vec_dot_q_cuda_t get_vec_dot_q_cuda_tbl(ggml_type type, mmvq_parameter_table_id table_id, int ncols_dst) {
+    if (table_id == MMVQ_PARAMETERS_PASCAL && ncols_dst == 1) {
         switch (type) {
             case GGML_TYPE_Q4_K: return vec_dot_q4_K_q8_1_wide;
             case GGML_TYPE_Q5_K: return vec_dot_q5_K_q8_1_wide;
@@ -888,12 +889,12 @@ static __global__ void mul_mat_vec_q(
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
-    constexpr int vdr = get_vdr_mmvq_tbl(type, table_id);
+    constexpr int vdr = get_vdr_mmvq_tbl(type, table_id, ncols_dst);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id, small_k, halve_iters);
     constexpr int rows_per_cuda_block = calc_rows_per_block(type, ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
 
-    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda_tbl(type, table_id);
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda_tbl(type, table_id, ncols_dst);
 
     const     int tid = warp_size*threadIdx.y + threadIdx.x;
     const     int row0 = rows_per_cuda_block*blockIdx.x;
@@ -1394,7 +1395,7 @@ static void mul_mat_vec_q_switch_ncols_dst(
     // How the K loop divides up at the baseline block width, both decisions below use these.
     constexpr int qk                    = ggml_cuda_type_traits<type>::qk;
     constexpr int qi                    = ggml_cuda_type_traits<type>::qi;
-    const int     vdr                   = get_vdr_mmvq_tbl(type, table_id);
+    const int     vdr                   = get_vdr_mmvq_tbl(type, table_id, 1); // only used for the ncols_dst == 1 decisions
     const int     blocks_per_row_x      = ncols_x / qk;
     const int     blocks_per_iter_1warp = vdr * warp_size / qi;
 
-- 
