 #pragma unroll
@@ -1028,10 +1030,10 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
                     s1 = ggml_cuda_dp4a(v[QI8_1 + l], u[QI8_1 + l], s1);
