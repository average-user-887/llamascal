+// p104 k1: Q6_K mat-vec for one column on Pascal. q6_K blocks are 210 bytes, so per-thread quant loads are 16-bit and
+// poorly coalesced. Here the block first copies the contiguous bytes of the super-blocks of this iteration into shared
+// memory with aligned 16-byte loads, then the unchanged vec_dot_q6_K_q8_1 reads the quants from shared memory.
+#ifndef P104_Q6_SMEM
+#define P104_Q6_SMEM 1
+#endif
+#ifndef P104_Q6S_NW
+#define P104_Q6S_NW 4
+#endif
+#ifndef P104_Q6S_RPB
+#define P104_Q6S_RPB 1
+#endif
+template <int nwarps, int rows_per_block>
+__launch_bounds__(nwarps*WARP_SIZE, 1)
+static __global__ void mul_mat_vec_q6_K_smem(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x) {
+    constexpr int vdr             = VDR_Q6_K_Q8_1_MMVQ;
+    constexpr int tpb             = QI6_K/vdr;                  // threads per super-block
+    constexpr int blocks_per_iter = nwarps*WARP_SIZE/tpb;
+    constexpr int bs              = sizeof(block_q6_K);
+    constexpr int n4_max          = (blocks_per_iter*bs + 15)/16 + 1;
+
+    __shared__ int4 xs[rows_per_block][n4_max];
+
+    const int tid  = WARP_SIZE*threadIdx.y + threadIdx.x;
+    const int row0 = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / QK_K;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    float tmp[rows_per_block] = {0.0f};
+
+    for (int base = 0; base < blocks_per_row_x; base += blocks_per_iter) {
+        const int nb = min(blocks_per_iter, blocks_per_row_x - base);
+        int off[rows_per_block];
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            const char * src    = (const char *) vx + ((int64_t) (row0 + i)*stride_row_x + base)*bs;
+            const int4 * src_al = (const int4 *) ((uintptr_t) src & ~(uintptr_t) 15);
+            off[i] = (int) ((uintptr_t) src & 15);
+            const int n4 = (off[i] + nb*bs + 15) / 16;
+            if (rows_per_block == 1 || row0 + i < nrows_x) {
+                for (int j = tid; j < n4; j += nwarps*WARP_SIZE) {
+                    xs[i][j] = src_al[j];
+                }
+            }
+        }
+        __syncthreads();
+
+        const int kbl = tid / tpb;
+        if (kbl < nb) {
+            const int kqs = vdr * (tid % tpb);
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp[i] += vec_dot_q6_K_q8_1((const char *) xs[i] + off[i], &y[(base + kbl)*(QK_K/QK8_1)], kbl, kqs);
+            }
+        }
+        __syncthreads();
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_block][WARP_SIZE];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x] = tmp[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+#pragma unroll
+    for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[i] += tmp_shared[l][i][threadIdx.x];
+        }
+        tmp[i] = warp_reduce_sum<WARP_SIZE>(tmp[i]);
+        if (threadIdx.x == i && (rows_per_block == 1 || row0 + i < nrows_x)) {
+            dst[row0 + i] = tmp[i];
+        }
+    }
+}
