+// 16 bytes from a 2-byte aligned address with 4-byte loads (q6_K blocks are 210 bytes, odd blocks are not 4-byte aligned).
+// May read up to 4 bytes past p + 16, callers keep that inside the block.
+static __device__ __forceinline__ void p104_load16_b2(const uint8_t * p, int * out) {
+    const uintptr_t a  = (uintptr_t) p;
+    const int     * pa = (const int *) (a & ~(uintptr_t) 3);
+    const int       sh = (a & 3) * 8;
+    int w[5];
+#pragma unroll
+    for (int i = 0; i < 5; ++i) {
+        w[i] = pa[i];
+    }
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        out[i] = __funnelshift_r(w[i], w[i+1], sh);
+    }
+}
+
+// p104 k1: Q6_K with vdr 4, 8 threads per super-block. Thread t = iqs/4 reads ql bytes [16t, 16t+16) so that the
+// threads of a super-block cover ql contiguously; half n = t/4, offset o = 16*(t%4) within the half's 64 ql bytes.
+static __device__ __forceinline__ float vec_dot_q6_K_q8_1_w4(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q6_K * bq6_K = (const block_q6_K *) vbq + kbx;
+    const int t  = iqs / 4;
+    const int n  = t / 4;
+    const int o  = 16 * (t % 4);
+    const int gb = o / 32;      // 0: ql low nibbles are sub-block 0 of the half, high nibbles sub-block 2; 1: sub-blocks 1, 3
+    const int l  = o % 32;
+
+    int Q[4];
+    int H[4];
+#if P104_Q6_B2
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        Q[i] = get_int_b2(bq6_K->ql, 4*t + i);
+        H[i] = get_int_b2(bq6_K->qh, 8*n + l/4 + i);
+    }
+#else
+    p104_load16_b2(bq6_K->ql + 16*t, Q);
+    p104_load16_b2(bq6_K->qh + 32*n + l, H);
+#endif
+
+    const int8_t * scales = bq6_K->scales + 8*n + l/16;
+
+    float sumf = 0.0f;
+
+#pragma unroll
+    for (int hi = 0; hi < 2; ++hi) {
+        const int g = gb + 2*hi;
+        const block_q8_1 * bq8g = bq8_1 + 4*n + g;
+        const int * q8 = (const int *) bq8g->qs + l/4;
+
+        int sumi = 0;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int vl = (Q[i] >> (4*hi)) & 0x0F0F0F0F;
+            const int vh = ((H[i] >> (2*g)) << 4) & 0x30303030;
+            const int u  = q8[i];
+            sumi = ggml_cuda_dp4a(vl | vh,  u, sumi);
+            sumi = ggml_cuda_dp4a(0xE0E0E0E0, u, sumi);
+        }
+
+        sumf += __low2float(bq8g->ds) * (sumi * scales[2*g]);
+    }
+
+    return __half2float(bq6_K->d) * sumf;
+}
