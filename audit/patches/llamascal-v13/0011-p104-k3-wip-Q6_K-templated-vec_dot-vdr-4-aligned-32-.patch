         if (ncols_dst == 1 && mmvq_pascal_tuned(type)) {
             return type == GGML_TYPE_Q6_K ? P104_NW_Q6 : P104_NW;
         }
+        if (ncols_dst >= 2 && ncols_dst <= 3 && mmvq_pascal_tuned(type)) {
+            return type == GGML_TYPE_Q6_K ? P104_NW_Q6_N23 : P104_NW_N23;
