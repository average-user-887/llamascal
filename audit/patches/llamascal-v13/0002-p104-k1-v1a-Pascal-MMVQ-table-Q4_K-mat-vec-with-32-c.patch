                 if (p104_mmvq_log()) {
                     fprintf(stderr, "p104mmvq type=%s k=%d m=%d ncols_dst=1 ids=%d gate=%d table=%d vdr=%d nwarps=%u grid=%u small_k=%d\n",
                         ggml_type_name(type), ncols_x, nrows_x, ids != nullptr, fusion.gate != nullptr, (int) table_id,
