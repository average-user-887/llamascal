Subject: [PATCH 02/17] p104 k1 v1a: Pascal MMVQ table, Q4_K mat-vec with 32
 contiguous quant bytes per thread (vdr 8, nwarps 2)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq.cu | 115 ++++++++++++++++++++++++++++++++++---
 1 file changed, 108 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 58391fd..2822368 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -91,6 +91,84 @@ static constexpr __host__ __device__ int get_vdr_mmvq(ggml_type type) {
     }
 }
 
+// p104 k1: MMVQ variant with vdr 8, iqs in 0, 8, 16, 24 selects sub-block pair iqs/8 (32 contiguous quant bytes).
+// The min term uses an exact dp4a sum of the q8_1 values, as vec_dot_q4_K_q8_1 does.
+#ifndef P104_EXACT_SUM
+#define P104_EXACT_SUM 1
+#endif
+static __device__ __forceinline__ float vec_dot_q4_K_q8_1_wide(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+    const int j = iqs / 8;
+
+    const int4 * q4 = (const int4 *) (bq4_K->qs + 32*j);
+    const int4 v0 = q4[0];
+    const int4 v1 = q4[1];
+    const int v[8] = {v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w};
+
+    const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+    const int jm = j & 1;
+
+    const uint32_t s0 = scales[jm + 0];
+    const uint32_t s2 = scales[jm + 2];
+    const uint32_t s4 = scales[jm + 4];
+
+    const uint32_t hi = (uint32_t) -(int32_t) (j >= 2);
+
+    uint16_t aux[2];
+    aux[0] = (uint16_t) (((s0 & 0x3f3f) & ~hi) | ((((s4 >> 0) & 0x0f0f) | ((s0 & 0xc0c0) >> 2)) & hi));
+    aux[1] = (uint16_t) (((s2 & 0x3f3f) & ~hi) | ((((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2)) & hi));
+    const uint8_t * sc = (const uint8_t *)aux;
+    const uint8_t * m  = sc + 2;
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + 2*j + i;
+        const int * q8 = (const int *) bq8i->qs;
+
+        int sumi_d = 0;
+#if P104_EXACT_SUM
+        int sumi_m = 0;
+#endif
+#pragma unroll
+        for (int l = 0; l < QI8_1; ++l) {
+            const int u = q8[l];
+            sumi_d = ggml_cuda_dp4a((v[l] >> (4*i)) & 0x0F0F0F0F, u, sumi_d);
+#if P104_EXACT_SUM
+            sumi_m = ggml_cuda_dp4a(0x01010101, u, sumi_m);
+#endif
+        }
+
+        const float2 ds8f = __half22float2(bq8i->ds);
+        sumf_d += ds8f.x * (sc[i] * sumi_d);
+#if P104_EXACT_SUM
+        sumf_m += ds8f.x * (sumi_m * m[i]);
+#else
+        sumf_m += ds8f.y * m[i];
+#endif
+    }
+
+    const float2 dm4f = __half22float2(bq4_K->dm);
+
+    return dm4f.x*sumf_d - dm4f.y*sumf_m;
+}
+
+// p104 k1: on Pascal (sm_61) the K-quant mat-vec is latency bound with 8 weight bytes per thread.
+// Wide variant: each thread handles a whole 32-byte quant run (two 16-byte loads) of one sub-block pair.
+#ifndef P104_NW
+#define P104_NW 2
+#endif
+#ifndef P104_RPB
+#define P104_RPB 1
+#endif
+static constexpr __host__ __device__ bool mmvq_pascal_wide(ggml_type type) {
+    return type == GGML_TYPE_Q4_K;
+}
+
 enum mmvq_parameter_table_id {
     MMVQ_PARAMETERS_GENERIC = 0,
     MMVQ_PARAMETERS_TURING,
@@ -100,7 +178,8 @@ enum mmvq_parameter_table_id {
     MMVQ_PARAMETERS_RDNA3_0,
     MMVQ_PARAMETERS_RDNA4,
     MMVQ_PARAMETERS_GB10,
-    MMVQ_PARAMETERS_ORIN
+    MMVQ_PARAMETERS_ORIN,
+    MMVQ_PARAMETERS_PASCAL
 };
 
 static constexpr __device__ mmvq_parameter_table_id get_device_table_id() {
@@ -120,6 +199,8 @@ static constexpr __device__ mmvq_parameter_table_id get_device_table_id() {
     return MMVQ_PARAMETERS_GB10;
 #elif __CUDA_ARCH__ == GGML_CUDA_CC_ORIN
     return MMVQ_PARAMETERS_ORIN;
+#elif __CUDA_ARCH__ >= GGML_CUDA_CC_DP4A && __CUDA_ARCH__ < GGML_CUDA_CC_VOLTA
+    return MMVQ_PARAMETERS_PASCAL;
 #else
     return MMVQ_PARAMETERS_GENERIC;
 #endif
@@ -150,6 +231,9 @@ static __host__ mmvq_parameter_table_id get_device_table_id(int cc) {
     if (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_ORIN) {
         return MMVQ_PARAMETERS_ORIN;
     }
+    if (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) >= GGML_CUDA_CC_DP4A && ggml_cuda_highest_compiled_arch(cc) < GGML_CUDA_CC_VOLTA) {
+        return MMVQ_PARAMETERS_PASCAL;
+    }
     return MMVQ_PARAMETERS_GENERIC;
 }
 
@@ -468,6 +552,14 @@ static constexpr __device__ int get_mmvq_mmid_max_batch_for_device() {
 #endif
 }
 
+static constexpr __host__ __device__ int get_vdr_mmvq_tbl(ggml_type type, mmvq_parameter_table_id table_id) {
+    return table_id == MMVQ_PARAMETERS_PASCAL && mmvq_pascal_wide(type) ? 8 : get_vdr_mmvq(type);
+}
+
+static constexpr __device__ vec_dot_q_cuda_t get_vec_dot_q_cuda_tbl(ggml_type type, mmvq_parameter_table_id table_id) {
+    return table_id == MMVQ_PARAMETERS_PASCAL && type == GGML_TYPE_Q4_K ? vec_dot_q4_K_q8_1_wide : get_vec_dot_q_cuda(type);
+}
+
 static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_dst, mmvq_parameter_table_id table_id, bool small_k = false, bool halve_iters = false) {
     if (table_id == MMVQ_PARAMETERS_GENERIC) {
         switch (ncols_dst) {
@@ -614,6 +706,12 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
     if (table_id == MMVQ_PARAMETERS_ORIN) {
         return calc_nwarps(type, ncols_dst, MMVQ_PARAMETERS_GENERIC);
     }
+    if (table_id == MMVQ_PARAMETERS_PASCAL) {
+        if (ncols_dst == 1 && mmvq_pascal_wide(type)) {
+            return P104_NW;
+        }
+        return calc_nwarps(type, ncols_dst, MMVQ_PARAMETERS_GENERIC);
+    }
     return 1;
 }
 
@@ -632,7 +730,10 @@ static constexpr __host__ __device__ bool mmvq_two_rows_ncols1(ggml_type type) {
 }
 
 static constexpr __host__ __device__ int calc_rows_per_block(ggml_type type, int ncols_dst, int table_id, bool small_k = false, int nwarps = 1) {
-    if (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GCN || table_id == MMVQ_PARAMETERS_TURING || table_id == MMVQ_PARAMETERS_GB10 || table_id == MMVQ_PARAMETERS_RDNA1) {
+    if (table_id == MMVQ_PARAMETERS_PASCAL && ncols_dst == 1 && !small_k && mmvq_pascal_wide(type)) {
+        return P104_RPB;
+    }
+    if (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GCN || table_id == MMVQ_PARAMETERS_TURING || table_id == MMVQ_PARAMETERS_GB10 || table_id == MMVQ_PARAMETERS_RDNA1 || table_id == MMVQ_PARAMETERS_PASCAL) {
         switch (ncols_dst) {
             case 1:
                 if (small_k) {
@@ -641,7 +742,7 @@ static constexpr __host__ __device__ int calc_rows_per_block(ggml_type type, int
                 if (table_id == MMVQ_PARAMETERS_GB10) {
                     return type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ3_S ? 2 : 1;
                 }
-                return (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_RDNA1) && mmvq_two_rows_ncols1(type) ? 2 : 1;
+                return (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_RDNA1 || table_id == MMVQ_PARAMETERS_PASCAL) && mmvq_two_rows_ncols1(type) ? 2 : 1;
             case 2:
             case 3:
             case 4:
@@ -708,13 +809,13 @@ static __global__ void mul_mat_vec_q(
 
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr = get_vdr_mmvq_tbl(type, table_id);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id, small_k, halve_iters);
     constexpr int rows_per_cuda_block = calc_rows_per_block(type, ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
 
-    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda_tbl(type, table_id);
 
     const     int tid = warp_size*threadIdx.y + threadIdx.x;
     const     int row0 = rows_per_cuda_block*blockIdx.x;
@@ -1215,7 +1316,7 @@ static void mul_mat_vec_q_switch_ncols_dst(
     // How the K loop divides up at the baseline block width, both decisions below use these.
     constexpr int qk                    = ggml_cuda_type_traits<type>::qk;
     constexpr int qi                    = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr                   = get_vdr_mmvq(type);
+    const int     vdr                   = get_vdr_mmvq_tbl(type, table_id);
     const int     blocks_per_row_x      = ncols_x / qk;
     const int     blocks_per_iter_1warp = vdr * warp_size / qi;
 
