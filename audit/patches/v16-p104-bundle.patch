     bool graph_evaluated_or_captured = false;
 
@@ -5417,6 +5482,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
+#ifdef GGML_P104_OPPROF_BUILD
+                if (p104_opprof_on() && !use_cuda_graph) { p104_opprof_mark(cuda_ctx->stream(), node); }
+#endif
 #ifdef USE_CUDA_GRAPH
                 // fused nodes are skipped together, so a cut never splits a fusion
                 // a concurrent region must join before its capture can end
@@ -5507,6 +5575,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
             }
         }
 
+#ifdef GGML_P104_OPPROF_BUILD
+        if (p104_opprof_on() && !use_cuda_graph) { p104_opprof_flush(cuda_ctx->stream()); }
+#endif
 #ifdef USE_CUDA_GRAPH
         if (use_cuda_graph && cuda_graph_update_required) { // End CUDA graph capture
